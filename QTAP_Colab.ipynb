    "## 🗂️ Cell 3: Fetch Real φ/ψ Data from RCSB PDB REST API\n",
    "\n",
    "We use the **RCSB PDB REST API** to:\n",
    "1. Query for high-resolution (≤2.0 Å), non-redundant X-ray structures\n",
    "2. Download each structure and extract backbone torsion angles with BioPython\n",
    "3. Cache results to `qtap_outputs/pdb_torsion_data.json` to avoid re-downloading\n",
    "\n",
    "This gives us **real, experimentally determined** φ/ψ angle distributions."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "fetch_pdb"},
   "source": [
    "CACHE_PATH = 'qtap_outputs/pdb_torsion_data.json'\n",
    "\n",
    "def query_rcsb_pdb_ids(n_chains: int = 100) -> list:\n",
    "    '''\n",
    "    Query RCSB PDB for high-resolution, non-redundant X-ray structures.\n",
    "    Filters: X-ray crystallography, resolution ≤ 2.0 Å, polymer entity = protein.\n",
    "    Returns a list of PDB IDs.\n",
    "    '''\n",
    "    url = 'https://search.rcsb.org/rcsbsearch/v2/query'\n",
    "    query = {\n",
    "        'query': {\n",
    "            'type': 'group',\n",
    "            'logical_operator': 'and',\n",
    "            'nodes': [\n",
    "                {\n",
    "                    'type': 'terminal',\n",
    "                    'service': 'text',\n",
    "                    'parameters': {\n",
    "                        'attribute': 'exptl.method',\n",
    "                        'operator': 'exact_match',\n",
    "                        'value': 'X-RAY DIFFRACTION'\n",
    "                    }\n",
    "                },\n",
    "                {\n",
    "                    'type': 'terminal',\n",
    "                    'service': 'text',\n",
    "                    'parameters': {\n",
    "                        'attribute': 'rcsb_entry_info.resolution_combined',\n",
    "                        'operator': 'less_or_equal',\n",
    "                        'value': 2.0\n",
    "                    }\n",
    "                },\n",
    "                {\n",
    "                    'type': 'terminal',\n",
    "                    'service': 'text',\n",
    "                    'parameters': {\n",
    "                        'attribute': 'entity_poly.rcsb_entity_polymer_type',\n",
    "                        'operator': 'exact_match',\n",
    "                        'value': 'Protein'\n",
    "                    }\n",
    "                }\n",
    "            ]\n",
    "        },\n",
    "        'return_type': 'entry',\n",
    "        'request_options': {\n",
    "            'paginate': {'start': 0, 'rows': n_chains},\n",
    "            'results_content_type': ['experimental'],\n",
    "            'sort': [{'sort_by': 'score', 'direction': 'desc'}]\n",
    "        }\n",
    "    }\n",
    "    resp = requests.post(url, json=query, timeout=30)\n",
    "    resp.raise_for_status()\n",
    "    results = resp.json()\n",
    "    ids = [r['identifier'] for r in results.get('result_set', [])]\n",
    "    return ids\n",
    "\n",
    "\n",
    "def extract_torsion_angles(pdb_id: str) -> dict:\n",
    "    '''\n",
    "    Download a PDB structure and extract backbone φ/ψ angles for each residue.\n",
    "    Uses BioPython PDBParser + PPBuilder.\n",
    "    Returns: {one_letter_aa: [(phi_deg, psi_deg), ...]}\n",
    "    '''\n",
    "    url = f'https://files.rcsb.org/download/{pdb_id}.pdb'\n",
    "    resp = requests.get(url, timeout=20)\n",
    "    if resp.status_code != 200:\n",
    "        return {}\n",
    "    \n",
    "    parser = PDBParser(QUIET=True)\n",
    "    try:\n",
    "        structure = parser.get_structure(pdb_id, StringIO(resp.text))\n",
    "    except Exception:\n",
    "        return {}\n",
    "    \n",
    "    ppb = PPBuilder()\n",
    "    torsions = defaultdict(list)\n",
    "    \n",
    "    for model in structure:\n",
    "        for pp in ppb.build_peptides(model, aa_only=True):\n",
    "            angles = pp.get_phi_psi_list()\n",
    "            residues = list(pp)\n",
    "            for res, (phi, psi) in zip(residues, angles):\n",
    "                if phi is None or psi is None:\n",
    "                    continue\n",
    "                try:\n",
    "                    aa = three_to_one(res.get_resname())\n",
    "                except Exception:\n",
    "                    continue\n",
    "                phi_deg = float(np.degrees(phi))\n",
    "                psi_deg = float(np.degrees(psi))\n",
    "                torsions[aa].append((phi_deg, psi_deg))\n",
    "        break  # first model only\n",
    "    \n",
    "    return dict(torsions)\n",
    "\n",
    "\n",
    "def load_or_fetch_torsion_data(n_chains: int, cache_path: str) -> dict:\n",
    "    '''Load cached torsion data or fetch fresh from RCSB PDB.'''\n",
    "    if os.path.exists(cache_path):\n",
    "        print(f'📂 Loading cached torsion data from {cache_path}...')\n",
    "        with open(cache_path) as f:\n",
    "            data = json.load(f)\n",
    "        total = sum(len(v) for v in data.values())\n",
    "        print(f'   ✅ Loaded {total:,} torsion angle pairs across {len(data)} residue types')\n",
    "        return data\n",
    "    \n",
    "    print(f'🌐 Querying RCSB PDB for {n_chains} high-resolution structures...')\n",
    "    pdb_ids = query_rcsb_pdb_ids(n_chains)\n",
    "    print(f'   Found {len(pdb_ids)} PDB IDs')\n",
    "    \n",
    "    all_torsions = defaultdict(list)\n",
    "    failed = 0\n",
    "    \n",
    "    for pdb_id in tqdm(pdb_ids, desc='Fetching PDB structures'):\n",
    "        try:\n",
    "            torsions = extract_torsion_angles(pdb_id)\n",
    "            for aa, pairs in torsions.items():\n",
    "                all_torsions[aa].extend(pairs)\n",
    "        except Exception as e:\n",
    "            failed += 1\n",
    "            continue\n",
    "    \n",
    "    result = {aa: pairs for aa, pairs in all_torsions.items() if len(pairs) >= MIN_ANGLES}\n",
    "    \n",
    "    with open(cache_path, 'w') as f:\n",
    "        json.dump(result, f)\n",
    "    \n",
    "    total = sum(len(v) for v in result.values())\n",
    "    print(f'\\n✅ Fetched {total:,} torsion angle pairs from {len(pdb_ids)-failed} structures')\n",
    "    print(f'   Failed: {failed} | Saved to {cache_path}')\n",
    "    return result\n",
    "\n",
    "\n",
    "torsion_data = load_or_fetch_torsion_data(N_PDB_CHAINS, CACHE_PATH)\n",
    "\n",
    "print('\\nAngle counts per residue type:')\n",
    "for aa in sorted(torsion_data.keys()):\n",
    "    print(f'   {aa}: {len(torsion_data[aa]):5,} φ/ψ pairs')"
   ],
   "outputs": [],
   "execution_count": null
  },
