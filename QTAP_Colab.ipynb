   "source": [
    "## 📊 Cell 4: Build Empirical Ramachandran Reference Distributions\n",
    "\n",
    "We bin the real PDB φ/ψ angles into a GRID_SIZE × GRID_SIZE grid covering [-180°, 180°] × [-180°, 180°].\n",
    "A small Laplace smoothing term (α = 1 pseudo-count) is added to avoid zero bins."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "ref_distributions"},
   "source": [
    "def angles_to_bin(phi: float, psi: float, grid_size: int) -> int:\n",
    "    '''\n",
    "    Map (phi, psi) in degrees to a flat bin index in a grid_size × grid_size grid\n",
    "    covering [-180, 180) × [-180, 180).\n",
    "    \n",
    "    Bin index = row * grid_size + col\n",
    "    Row = psi bin (0 = most negative psi), Col = phi bin (0 = most negative phi)\n",
    "    '''\n",
    "    phi_norm = (phi + 180.0) / 360.0  # [0,1)\n",
    "    psi_norm = (psi + 180.0) / 360.0\n",
    "    col = int(np.clip(phi_norm * grid_size, 0, grid_size - 1))\n",
    "    row = int(np.clip(psi_norm * grid_size, 0, grid_size - 1))\n",
    "    return row * grid_size + col\n",
    "\n",
    "\n",
    "def build_reference_distribution(\n",
    "    aa: str,\n",
    "    torsion_data: dict,\n",
    "    grid_size: int,\n",
    "    alpha: float = 1.0   # Laplace smoothing pseudo-count\n",
    ") -> np.ndarray:\n",
    "    '''\n",
    "    Build a smoothed empirical Ramachandran distribution for amino acid aa.\n",
    "    \n",
    "    Args:\n",
    "        aa:           one-letter amino acid code\n",
    "        torsion_data: dict mapping aa → list of (phi_deg, psi_deg) tuples\n",
    "        grid_size:    number of bins per axis\n",
    "        alpha:        Laplace smoothing (add-alpha smoothing)\n",
    "    \n",
    "    Returns:\n",
    "        dist: np.ndarray of shape (grid_size^2,), sums to 1.0\n",
    "    '''\n",
    "    n_bins = grid_size * grid_size\n",
    "    counts = np.full(n_bins, alpha)   # Laplace smoothing\n",
    "    \n",
    "    pairs = torsion_data.get(aa, [])\n",
    "    for phi, psi in pairs:\n",
    "        b = angles_to_bin(phi, psi, grid_size)\n",
    "        counts[b] += 1.0\n",
    "    \n",
    "    dist = counts / counts.sum()\n",
    "    return dist\n",
    "\n",
    "\n",
    "# Build distributions for all AAs with sufficient data\n",
    "ref_distributions = {}\n",
    "for aa in AA_LIST:\n",
    "    if aa in torsion_data and len(torsion_data[aa]) >= MIN_ANGLES:\n",
    "        ref_distributions[aa] = build_reference_distribution(aa, torsion_data, GRID_SIZE)\n",
    "    else:\n",
    "        print(f'   ⚠️  Insufficient data for {aa}, skipping')\n",
    "\n",
    "# Sanity checks\n",
    "for aa, dist in ref_distributions.items():\n",
    "    assert abs(dist.sum() - 1.0) < 1e-5\n",
    "    assert (dist > 0).all(), f'{aa} has zero bins after smoothing'\n",
    "\n",
    "available_aa = sorted(ref_distributions.keys())\n",
    "print(f'✅ Reference distributions built for {len(ref_distributions)} amino acids:')\n",
    "print(f'   {available_aa}')\n",
    "print(f'\\nExample — Ala (A), top 5 bins:')\n",
    "dist_A = ref_distributions.get('A', None)\n",
    "if dist_A is not None:\n",
    "    top5 = np.argsort(dist_A)[::-1][:5]\n",
    "    for b in top5:\n",
    "        row, col = divmod(b, GRID_SIZE)\n",
    "        phi_c = -180 + (col + 0.5) * 360 / GRID_SIZE\n",
    "        psi_c = -180 + (row + 0.5) * 360 / GRID_SIZE\n",
    "        print(f'   bin {b:2d} (φ≈{phi_c:+.0f}°, ψ≈{psi_c:+.0f}°): p={dist_A[b]:.4f}')"
   ],
   "outputs": [],
   "execution_count": null
  },
