   "source": [
    "## ⚛️ Cell 5: Variational Quantum Born Machine Circuit\n",
    "\n",
    "**Hardware-efficient ansatz** with:\n",
    "- Encoding layer: RY(feature_angle_i) on each qubit\n",
    "- d variational layers: Ry(θ) + Rz(φ) per qubit + linear CNOT entangler\n",
    "- Full measurement → Born distribution over 2^N bins\n",
    "\n",
    "Total variational parameters: 2 × N_QUBITS × CIRCUIT_DEPTH"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "circuit_builder"},
   "source": [
    "def build_qtap_circuit(n_qubits: int, depth: int):\n",
    "    '''\n",
    "    Build the hardware-efficient QTAP variational ansatz.\n",
    "    \n",
    "    Returns:\n",
    "        qc:        QuantumCircuit with parameters\n",
    "        enc_params: ParameterVector for encoding layer (length = n_qubits)\n",
    "        var_params: ParameterVector for variational layers (length = 2*n_qubits*depth)\n",
    "    '''\n",
    "    enc_params = ParameterVector('enc', n_qubits)\n",
    "    var_params = ParameterVector('var', 2 * n_qubits * depth)\n",
    "    qc = QuantumCircuit(n_qubits)\n",
    "    \n",
    "    # Encoding layer\n",
    "    for i in range(n_qubits):\n",
    "        qc.ry(enc_params[i], i)\n",
    "    qc.barrier()\n",
    "    \n",
    "    # Variational layers\n",
    "    idx = 0\n",
    "    for d in range(depth):\n",
    "        for i in range(n_qubits):\n",
    "            qc.ry(var_params[idx], i); idx += 1\n",
    "        for i in range(n_qubits):\n",
    "            qc.rz(var_params[idx], i); idx += 1\n",
    "        for i in range(n_qubits - 1):\n",
    "            qc.cx(i, i + 1)\n",
    "        if d < depth - 1:\n",
    "            qc.barrier()\n",
    "    \n",
    "    qc.measure_all()\n",
    "    return qc, enc_params, var_params\n",
    "\n",
    "\n",
    "qtap_circuit, enc_params, var_params = build_qtap_circuit(N_QUBITS, CIRCUIT_DEPTH)\n",
    "N_VAR_PARAMS = len(var_params)\n",
    "N_ENC_PARAMS = len(enc_params)\n",
    "\n",
    "print(f'✅ QTAP circuit built:')\n",
    "print(f'   Qubits:             {N_QUBITS}')\n",
    "print(f'   Depth:              {CIRCUIT_DEPTH}')\n",
    "print(f'   Encoding params:    {N_ENC_PARAMS}')\n",
    "print(f'   Variational params: {N_VAR_PARAMS}')\n",
    "print(f'   Total params:       {N_ENC_PARAMS + N_VAR_PARAMS}')\n",
    "print()\n",
    "print(qtap_circuit.draw(output='text', fold=80))"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🔢 Cell 6: Residue Physicochemical Feature Encoder"]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "feature_encoder"},
   "source": [
    "# Physicochemical properties per amino acid\n",
    "# Source: Kyte & Doolittle (1982), Stryer Biochemistry, standard references\n",
    "# Format: (MW g/mol, Kyte-Doolittle hydrophobicity, pI, formal charge pH7, aromaticity flag)\n",
    "AA_PROPERTIES = {\n",
    "    'A': (89.09,   1.800,  6.00,  0.0, 0.0),\n",
    "    'C': (121.16,  2.500,  5.07,  0.0, 0.0),\n",
    "    'D': (133.10, -3.500,  2.77, -1.0, 0.0),\n",
    "    'E': (147.13, -3.500,  3.22, -1.0, 0.0),\n",
    "    'F': (165.19,  2.800,  5.48,  0.0, 1.0),\n",
    "    'G': (75.03,  -0.400,  5.97,  0.0, 0.0),\n",
    "    'H': (155.16, -3.200,  7.59, +0.1, 1.0),\n",
    "    'I': (131.17,  4.500,  6.02,  0.0, 0.0),\n",
    "    'K': (146.19, -3.900, 10.53, +1.0, 0.0),\n",
    "    'L': (131.17,  3.800,  5.98,  0.0, 0.0),\n",
    "    'M': (149.21,  1.900,  5.74,  0.0, 0.0),\n",
    "    'N': (132.12, -3.500,  5.41,  0.0, 0.0),\n",
    "    'P': (115.13, -1.600,  6.30,  0.0, 0.0),\n",
    "    'Q': (146.15, -3.500,  5.65,  0.0, 0.0),\n",
    "    'R': (174.20, -4.500, 10.76, +1.0, 0.0),\n",
    "    'S': (105.09, -0.800,  5.68,  0.0, 0.0),\n",
    "    'T': (119.12, -0.700,  5.60,  0.0, 0.0),\n",
    "    'V': (117.15,  4.200,  5.96,  0.0, 0.0),\n",
    "    'W': (204.23, -0.900,  5.89,  0.0, 1.0),\n",
    "    'Y': (181.19, -1.300,  5.66,  0.0, 1.0),\n",
    "}\n",
    "\n",
    "# Global min/max for normalization (computed from AA_PROPERTIES above)\n",
    "_PROP_RANGES = [\n",
    "    (min(v[i] for v in AA_PROPERTIES.values()),\n",
    "     max(v[i] for v in AA_PROPERTIES.values()))\n",
    "    for i in range(5)\n",
    "]\n",
    "\n",
    "def encode_residue(aa: str, n_qubits: int) -> np.ndarray:\n",
    "    '''\n",
    "    Encode an amino acid's physicochemical properties into n_qubits encoding angles.\n",
    "    Each property is linearly normalized to [0, 2π].\n",
    "    Uses first n_qubits properties (MW, hydrophobicity, pI, charge, aromaticity).\n",
    "    '''\n",
    "    props = AA_PROPERTIES[aa]\n",
    "    angles = []\n",
    "    for i in range(n_qubits):\n",
    "        lo, hi = _PROP_RANGES[i]\n",
    "        if hi - lo < 1e-9:\n",
    "            angles.append(0.0)\n",
    "        else:\n",
    "            normalized = (props[i] - lo) / (hi - lo)\n",
    "            angles.append(normalized * 2 * np.pi)\n",
    "    return np.array(angles[:n_qubits])\n",
    "\n",
    "\n",
    "encoding_angles = {aa: encode_residue(aa, N_QUBITS) for aa in AA_LIST}\n",
    "\n",
    "print('✅ Encoding angles (radians, [0, 2π]) for selected residues:')\n",
    "for aa in ['A', 'G', 'P', 'W', 'D', 'K']:\n",
    "    angs = encoding_angles[aa]\n",
    "    print(f'   {aa}: {np.round(angs, 3)}')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🔁 Cell 7: Born Machine Forward Pass + Parameter-Shift Gradients\n",
    "\n",
    "**Parameter-shift rule** (Mitarai et al. 2018, Schuld et al. 2019):\n",
    "For a gate G(θ) = exp(-iθP/2) with Pauli generator P:\n",
    "$$\\frac{\\partial \\langle O \\rangle}{\\partial \\theta} = \\frac{1}{2}\\left[\\langle O \\rangle_{\\theta+\\pi/2} - \\langle O \\rangle_{\\theta-\\pi/2}\\right]$$\n",
    "\n",
    "We extend this to the KL divergence loss by differentiating through the Born probabilities."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "forward_and_gradients"},
   "source": [
    "def _run_circuit(\n",
    "    circuit: QuantumCircuit,\n",
    "    enc_params: ParameterVector,\n",
    "    var_params: ParameterVector,\n",
    "    enc_values: np.ndarray,\n",
    "    var_values: np.ndarray,\n",
    "    n_qubits: int,\n",
    "    n_shots: int,\n",
    "    simulator: AerSimulator\n",
    ") -> np.ndarray:\n",
    "    '''Execute bound circuit and return smoothed Born probability vector.'''\n",
    "    n_bins = 2**n_qubits\n",
    "    param_dict = {}\n",
    "    for i, p in enumerate(enc_params):\n",
    "        param_dict[p] = float(enc_values[i])\n",
    "    for i, p in enumerate(var_params):\n",
    "        param_dict[p] = float(var_values[i])\n",
    "    \n",
    "    bound = circuit.assign_parameters(param_dict)\n",
    "    transpiled = transpile(bound, simulator, optimization_level=1)\n",
    "    counts = simulator.run(transpiled, shots=n_shots).result().get_counts()\n",
    "    \n",
    "    prob = np.zeros(n_bins)\n",
    "    for bitstring, count in counts.items():\n",
    "        prob[int(bitstring, 2)] += count\n",
    "    prob /= prob.sum()\n",
    "    prob = (prob + 1e-9) / (prob + 1e-9).sum()  # Laplace smoothing\n",
    "    return prob\n",
    "\n",
    "\n",
    "def born_distribution(enc_values, var_values, n_shots=None):\n",
    "    '''Convenience wrapper using global circuit and config.'''\n",
    "    s = n_shots or N_SHOTS\n",
    "    return _run_circuit(qtap_circuit, enc_params, var_params,\n",
    "                        enc_values, var_values, N_QUBITS, s, DEVICE)\n",
    "\n",
    "\n",
    "def kl_divergence(p_ref: np.ndarray, p_pred: np.ndarray) -> float:\n",
    "    '''KL(p_ref ‖ p_pred) in nats. Both arrays must be strictly positive.'''\n",
    "    assert (p_ref > 0).all() and (p_pred > 0).all()\n",
    "    return float(np.sum(rel_entr(p_ref, p_pred)))\n",
    "\n",
    "\n",
    "def parameter_shift_gradient(\n",
    "    enc_values: np.ndarray,\n",
    "    var_values: np.ndarray,\n",
    "    p_ref: np.ndarray,\n",
    "    shift: float = np.pi / 2,\n",
    "    n_shots: int = None\n",
    ") -> np.ndarray:\n",
    "    '''\n",
    "    Compute exact gradient of KL(p_ref ‖ p_θ) w.r.t. var_values\n",
    "    using the parameter-shift rule.\n",
    "    \n",
    "    ∂KL/∂θ_k = -∑_x p_ref(x) * [∂ log p_θ(x)/∂θ_k]\n",
    "             = -∑_x p_ref(x) * [(p_θ+(x) - p_θ-(x)) / (2 * p_θ(x))]\n",
    "    where p_θ± is the Born distribution with θ_k ± π/2.\n",
    "    \n",
    "    Returns:\n",
    "        grad: np.ndarray of shape (n_var_params,)\n",
    "    '''\n",
    "    s = n_shots or N_GRAD_SHOTS\n",
    "    n_params = len(var_values)\n",
    "    grad = np.zeros(n_params)\n",
    "    \n",
    "    p_curr = born_distribution(enc_values, var_values, n_shots=s)\n",
    "    \n",
    "    for k in range(n_params):\n",
    "        theta_plus  = var_values.copy(); theta_plus[k]  += shift\n",
    "        theta_minus = var_values.copy(); theta_minus[k] -= shift\n",
    "        \n",
    "        p_plus  = born_distribution(enc_values, theta_plus,  n_shots=s)\n",
    "        p_minus = born_distribution(enc_values, theta_minus, n_shots=s)\n",
    "        \n",
    "        # ∂KL/∂θ_k = -∑_x p_ref(x) * (p_plus(x) - p_minus(x)) / (2 * p_curr(x))\n",
    "        grad[k] = -np.sum(p_ref * (p_plus - p_minus) / (2.0 * p_curr))\n",
    "    \n",
    "    return grad\n",
    "\n",
    "\n",
    "# Quick smoke test\n",
    "print('Smoke testing forward pass and gradients...')\n",
    "_test_theta = np.random.uniform(0, 2*np.pi, N_VAR_PARAMS)\n",
    "_test_enc   = encoding_angles.get('A', np.zeros(N_QUBITS))\n",
    "_test_ref   = ref_distributions.get('A', np.ones(N_BINS)/N_BINS)\n",
    "\n",
    "_test_prob = born_distribution(_test_enc, _test_theta)\n",
    "_test_kl   = kl_divergence(_test_ref, _test_prob)\n",
    "print(f'  Forward pass ✅  prob.sum={_test_prob.sum():.6f}, KL={_test_kl:.4f} nats')\n",
    "\n",
    "_test_grad = parameter_shift_gradient(_test_enc, _test_theta, _test_ref)\n",
    "print(f'  Gradients   ✅  grad.shape={_test_grad.shape}, |grad|={np.linalg.norm(_test_grad):.4f}')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 🏋️ Cell 8: ADAM Training Loop\n",
    "\n",
    "We implement **ADAM** (Kingma & Ba 2015) from scratch using parameter-shift gradients.\n",
    "This ensures compatibility with Qiskit's parameterized circuits without requiring\n",
    "a differentiable quantum computing framework."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "adam_training"},
   "source": [
    "def adam_optimize_qtap(\n",
    "    aa: str,\n",
    "    ref_dist: np.ndarray,\n",
    "    enc_values: np.ndarray,\n",
    "    n_epochs: int,\n",
    "    lr: float,\n",
    "    beta1: float,\n",
    "    beta2: float,\n",
    "    eps: float,\n",
    "    verbose: bool = True\n",
    ") -> dict:\n",
    "    '''\n",
    "    Train QTAP for a single amino acid using ADAM with parameter-shift gradients.\n",
    "    \n",
    "    Args:\n",
    "        aa:         amino acid one-letter code\n",
    "        ref_dist:   empirical PDB reference distribution (n_bins,)\n",
    "        enc_values: fixed encoding angles for this residue\n",
    "        n_epochs:   number of ADAM update steps\n",
    "        lr, beta1, beta2, eps: ADAM hyperparameters\n",
    "    \n",
    "    Returns:\n",
    "        dict with keys: aa, final_kl, best_kl, best_params, history\n",
    "    '''\n",
    "    theta   = np.random.uniform(0, 2*np.pi, N_VAR_PARAMS)\n",
    "    m       = np.zeros(N_VAR_PARAMS)   # first moment\n",
    "    v       = np.zeros(N_VAR_PARAMS)   # second moment\n",
    "    history = []\n",
    "    best_kl = np.inf\n",
    "    best_params = theta.copy()\n",
    "    \n",
    "    for t in range(1, n_epochs + 1):\n",
    "        # Compute parameter-shift gradient\n",
    "        grad = parameter_shift_gradient(enc_values, theta, ref_dist)\n",
    "        \n",
    "        # ADAM update\n",
    "        m = beta1 * m + (1 - beta1) * grad\n",
    "        v = beta2 * v + (1 - beta2) * grad**2\n",
    "        m_hat = m / (1 - beta1**t)\n",
    "        v_hat = v / (1 - beta2**t)\n",
    "        theta = theta - lr * m_hat / (np.sqrt(v_hat) + eps)\n",
    "        \n",
    "        # Evaluate KL every 5 epochs\n",
    "        if t % 5 == 0 or t == 1:\n",
    "            prob = born_distribution(enc_values, theta)\n",
    "            kl   = kl_divergence(ref_dist, prob)\n",
    "            history.append((t, kl))\n",
    "            if kl < best_kl:\n",
    "                best_kl     = kl\n",
    "                best_params = theta.copy()\n",
    "    \n",
    "    final_prob = born_distribution(enc_values, best_params, n_shots=N_SHOTS * 4)\n",
    "    final_kl   = kl_divergence(ref_dist, final_prob)\n",
    "    \n",
    "    if verbose:\n",
    "        print(f'   {aa}: best_kl={best_kl:.4f}, final_kl={final_kl:.4f} ({n_epochs} epochs)')\n",
    "    \n",
    "    return {\n",
    "        'aa':          aa,\n",
    "        'final_kl':    float(final_kl),\n",
    "        'best_kl':     float(best_kl),\n",
    "        'best_params': best_params.tolist(),\n",
    "        'history':     history\n",
    "    }\n",
    "\n",
    "\n",
    "# Select training targets\n",
    "demo_aa = [aa for aa in ['A', 'G', 'P', 'V'] if aa in ref_distributions]\n",
    "train_targets = [aa for aa in AA_LIST if aa in ref_distributions] if FULL_TRAINING else demo_aa\n",
    "\n",
    "print(f'Training QTAP on: {train_targets}')\n",
    "print(f'ADAM: lr={ADAM_LR}, β1={ADAM_BETA1}, β2={ADAM_BETA2}, epochs={N_EPOCHS}')\n",
    "print(f'Parameter-shift shots per gradient: {N_GRAD_SHOTS} × {N_VAR_PARAMS} params × 2 = {N_GRAD_SHOTS*N_VAR_PARAMS*2} total\\n')\n",
    "\n",
    "all_results = {}\n",
    "t_start = time.time()\n",
    "\n",
    "for aa in tqdm(train_targets, desc='Training QTAP (ADAM + param-shift)'):\n",
    "    result = adam_optimize_qtap(\n",
    "        aa           = aa,\n",
    "        ref_dist     = ref_distributions[aa],\n",
    "        enc_values   = encoding_angles[aa],\n",
    "        n_epochs     = N_EPOCHS,\n",
    "        lr           = ADAM_LR,\n",
    "        beta1        = ADAM_BETA1,\n",
    "        beta2        = ADAM_BETA2,\n",
    "        eps          = ADAM_EPS,\n",
    "        verbose      = True\n",
    "    )\n",
    "    all_results[aa] = result\n",
    "\n",
    "print(f'\\n✅ Training complete in {time.time()-t_start:.1f}s')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🤖 Cell 9: Classical MLP Baseline (PyTorch)"]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "mlp_baseline"},
   "source": [
    "class RamachandranMLP(nn.Module):\n",
    "    '''\n",
    "    Classical MLP baseline for Ramachandran distribution prediction.\n",
    "    Architecture: [5 → 64 → 64 → N_BINS], softmax output.\n",
    "    Loss: forward KL divergence, ADAM optimizer.\n",
    "    '''\n",
    "    def __init__(self, input_dim=5, hidden=64, out=16):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(input_dim, hidden), nn.ReLU(),\n",
    "            nn.Linear(hidden, hidden),    nn.ReLU(),\n",
    "            nn.Linear(hidden, out),        nn.Softmax(dim=-1)\n",
    "        )\n",
    "    def forward(self, x): return self.net(x)\n",
    "    def n_params(self): return sum(p.numel() for p in self.parameters() if p.requires_grad)\n",
    "\n",
    "\n",
    "def train_mlp(train_aas, ref_distributions, n_epochs=3000, lr=1e-3):\n",
    "    # Build (feature, target) pairs from real reference distributions\n",
    "    X, Y = [], []\n",
    "    for aa in train_aas:\n",
    "        props = list(AA_PROPERTIES[aa])\n",
    "        norms = [max(r[1] for r in _PROP_RANGES)] + [hi-lo if hi-lo > 1e-9 else 1.0\n",
    "                  for lo, hi in _PROP_RANGES[1:]]\n",
    "        feat = [(props[i] - _PROP_RANGES[i][0]) / (_PROP_RANGES[i][1] - _PROP_RANGES[i][0] + 1e-9)\n",
    "                for i in range(5)]\n",
    "        X.append(feat)\n",
    "        Y.append(ref_distributions[aa].tolist())\n",
    "    \n",
    "    X_t = torch.tensor(X, dtype=torch.float32)\n",
    "    Y_t = torch.tensor(Y, dtype=torch.float32)\n",
    "    \n",
    "    model = RamachandranMLP(input_dim=5, hidden=64, out=N_BINS)\n",
    "    opt   = optim.Adam(model.parameters(), lr=lr)\n",
    "    kl_fn = nn.KLDivLoss(reduction='batchmean')\n",
    "    \n",
    "    for _ in range(n_epochs):\n",
    "        opt.zero_grad()\n",
    "        loss = kl_fn(torch.log(model(X_t) + 1e-9), Y_t)\n",
    "        loss.backward(); opt.step()\n",
    "    \n",
    "    model.eval()\n",
    "    results = {}\n",
    "    with torch.no_grad():\n",
    "        preds = model(X_t).numpy()\n",
    "        for i, aa in enumerate(train_aas):\n",
    "            kl = kl_divergence(ref_distributions[aa], preds[i] + 1e-9)\n",
    "            results[aa] = {'kl': float(kl), 'pred_dist': preds[i].tolist()}\n",
    "    return model, results\n",
    "\n",
    "\n",
    "print('Training classical MLP baseline...')\n",
    "mlp_model, mlp_results = train_mlp(train_targets, ref_distributions)\n",
    "n_mlp  = mlp_model.n_params()\n",
    "n_qtap = N_VAR_PARAMS\n",
    "print(f'✅ MLP trained: {n_mlp} params vs QTAP {n_qtap} params ({n_mlp/n_qtap:.1f}× more)')"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
