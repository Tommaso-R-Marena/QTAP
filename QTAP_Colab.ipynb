{\n "cells": [\n  {\n   "cell_type": "markdown",\n   "id": "81309cd1",\n   "metadata": {},\n   "source": [\n    "# QTAP: Quantum Torsion Angle Predictor\n",\n    "End-to-end Colab demo: variational quantum Born machine for Ramachandran φ/ψ distributions."\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "38ed17da",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "import sys, subprocess\n",\n    "for p in [\"qiskit>=1.0.0\",\"qiskit-aer>=0.14.0\",\"scipy\",\"matplotlib\",\"pandas\",\"torch\",\"tqdm\"]:\n",\n    "    subprocess.check_call([sys.executable,\"-m\",\"pip\",\"install\",\"-q\",p])\n",\n    "print(\"installed\")"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "3bd0ef00",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "import numpy as np, pandas as pd, matplotlib.pyplot as plt, torch, torch.nn as nn\n",\n    "from scipy.optimize import minimize\n",\n    "from scipy.special import rel_entr\n",\n    "from qiskit import QuantumCircuit, transpile\n",\n    "from qiskit.circuit import ParameterVector\n",\n    "from qiskit_aer import AerSimulator\n",\n    "from tqdm.notebook import tqdm\n",\n    "np.random.seed(42); torch.manual_seed(42)\n",\n    "NQ=4; NB=16; DEPTH=3; SHOTS=1024; STEPS=180; sim=AerSimulator()\n",\n    "AA=list(\"ACDEFGHIKLMNPQRSTVWY\")"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "544aeec4",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "def refdist(a):\n",\n    "    d=np.zeros(16)\n",\n    "    if a==\"G\": d[:]=1/16\n",\n    "    elif a==\"P\": d[[5,13,4]]=[.60,.30,.10]\n",\n    "    elif a in \"AVILMFYW\": d[[5,12,13,4]]=[.40,.35,.15,.10]\n",\n    "    elif a in \"DENQ\": d[[5,12,13,1]]=[.50,.25,.15,.10]\n",\n    "    elif a in \"KRH\": d[[5,12,13,10]]=[.35,.30,.20,.15]\n",\n    "    elif a in \"ST\": d[[12,5,13]]=[.45,.30,.25]\n",\n    "    else: d[[5,12,13,4]]=[.38,.32,.18,.12]\n",\n    "    d+=1e-6; return d/d.sum()\n",\n    "refs={a:refdist(a) for a in AA}\n",\n    "print(\"example Ala\", np.round(refs[\"A\"],3))"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "602a83cf",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "props={\"A\":(89.09,1.8,6,0,0),\"C\":(121.16,2.5,5.07,0,0),\"D\":(133.1,-3.5,2.77,-1,0),\"E\":(147.13,-3.5,3.22,-1,0),\"F\":(165.19,2.8,5.48,0,1),\"G\":(75.03,-.4,5.97,0,0),\"H\":(155.16,-3.2,7.59,.1,1),\"I\":(131.17,4.5,6.02,0,0),\"K\":(146.19,-3.9,10.53,1,0),\"L\":(131.17,3.8,5.98,0,0),\"M\":(149.21,1.9,5.74,0,0),\"N\":(132.12,-3.5,5.41,0,0),\"P\":(115.13,-1.6,6.3,0,0),\"Q\":(146.15,-3.5,5.65,0,0),\"R\":(174.2,-4.5,10.76,1,0),\"S\":(105.09,-.8,5.68,0,0),\"T\":(119.12,-.7,5.6,0,0),\"V\":(117.15,4.2,5.96,0,0),\"W\":(204.23,-.9,5.89,0,1),\"Y\":(181.19,-1.3,5.66,0,1)}\n",\n    "ranges=[(75.03,204.23),(-4.5,4.5),(2.77,10.76),(-1,1)]\n",\n    "def encode(a):\n",\n    "    return np.array([(props[a][i]-lo)/(hi-lo)*2*np.pi for i,(lo,hi) in enumerate(ranges)])\n",\n    "enc={a:encode(a) for a in AA}"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "e8f2137e",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "def circuit(nq=NQ,depth=DEPTH):\n",\n    "    e=ParameterVector(\"enc\",nq); v=ParameterVector(\"var\",2*nq*depth); qc=QuantumCircuit(nq)\n",\n    "    for i in range(nq): qc.ry(e[i],i)\n",\n    "    k=0\n",\n    "    for _ in range(depth):\n",\n    "        for i in range(nq): qc.ry(v[k],i); k+=1\n",\n    "        for i in range(nq): qc.rz(v[k],i); k+=1\n",\n    "        for i in range(nq-1): qc.cx(i,i+1)\n",\n    "    qc.measure_all(); return qc,e,v\n",\n    "qc,epar,vpar=circuit(); print(qc.draw(output=\"text\")); print(\"params\",len(vpar))"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "004d92cf",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "def born(qc,epar,vpar,x,theta,shots=SHOTS):\n",\n    "    bind={p:float(x[i]) for i,p in enumerate(epar)}; bind.update({p:float(theta[i]) for i,p in enumerate(vpar)})\n",\n    "    counts=sim.run(transpile(qc.assign_parameters(bind),sim),shots=shots).result().get_counts()\n",\n    "    p=np.zeros(2**NQ)\n",\n    "    for b,c in counts.items(): p[int(b,2)]+=c\n",\n    "    p=p/p.sum()+1e-9; return p/p.sum()\n",\n    "def KL(a,b): return float(np.sum(rel_entr(a,b)))\n",\n    "def train(a,steps=STEPS):\n",\n    "    th0=np.random.uniform(0,2*np.pi,len(vpar)); hist=[]\n",\n    "    def obj(th):\n",\n    "        loss=KL(refs[a],born(qc,epar,vpar,enc[a],th)); hist.append(loss); return loss\n",\n    "    r=minimize(obj,th0,method=\"COBYLA\",options={\"maxiter\":steps,\"rhobeg\":0.5})\n",\n    "    return {\"kl\":float(r.fun),\"theta\":r.x,\"hist\":hist}\n",\n    "targets=[\"A\",\"G\",\"P\",\"V\"]\n",\n    "res={a:train(a) for a in tqdm(targets)}\n",\n    "print({a:round(res[a][\"kl\"],3) for a in targets})"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "a5148b89",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "class MLP(nn.Module):\n",\n    "    def __init__(self): super().__init__(); self.net=nn.Sequential(nn.Linear(5,64),nn.ReLU(),nn.Linear(64,64),nn.ReLU(),nn.Linear(64,16),nn.Softmax(-1))\n",\n    "    def forward(self,x): return self.net(x)\n",\n    "mlp=MLP(); opt=torch.optim.Adam(mlp.parameters(),lr=1e-3); lossfn=nn.KLDivLoss(reduction=\"batchmean\")\n",\n    "X=torch.tensor([[props[a][i]/[129,4.5,6.77,1,.5][i] for i in range(5)] for a in targets],dtype=torch.float32)\n",\n    "Y=torch.tensor([refs[a] for a in targets],dtype=torch.float32)\n",\n    "for _ in range(1500):\n",\n    "    opt.zero_grad(); pred=mlp(X); loss=lossfn(torch.log(pred+1e-9),Y); loss.backward(); opt.step()\n",\n    "with torch.no_grad(): mp=mlp(X).numpy()\n",\n    "rows=[]\n",\n    "for i,a in enumerate(targets): rows.append([a,res[a][\"kl\"],KL(refs[a],mp[i]),\"QTAP\" if res[a][\"kl\"]<=KL(refs[a],mp[i]) else \"MLP\"])\n",\n    "df=pd.DataFrame(rows,columns=[\"Residue\",\"QTAP_KL\",\"MLP_KL\",\"Winner\"]); df"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "b4ff2d07",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "import os, json\n",\n    "os.makedirs(\"qtap_outputs\",exist_ok=True)\n",\n    "labels=[\"-180\",\"-90\",\"0\",\"+90\"]\n",\n    "for i,a in enumerate(targets):\n",\n    "    qp=born(qc,epar,vpar,enc[a],res[a][\"theta\"],shots=4096); grids=[refs[a].reshape(4,4),qp.reshape(4,4),mp[i].reshape(4,4)]\n",\n    "    fig,axs=plt.subplots(1,3,figsize=(12,3.5)); fig.suptitle(f\"Ramachandran distribution: {a}\")\n",\n    "    for ax,g,t in zip(axs,grids,[\"reference\",\"QTAP\",\"MLP\"]):\n",\n    "        im=ax.imshow(g,origin=\"lower\",cmap=\"hot_r\",vmin=0,vmax=max(x.max() for x in grids)); ax.set_title(t); ax.set_xticks(range(4)); ax.set_yticks(range(4)); ax.set_xticklabels(labels); ax.set_yticklabels(labels)\n",\n    "        for r in range(4):\n",\n    "            for c in range(4): ax.text(c,r,f\"{g[r,c]:.2f}\",ha=\"center\",va=\"center\",fontsize=8)\n",\n    "    plt.tight_layout(); plt.savefig(f\"qtap_outputs/ramachandran_{a}.png\",dpi=150); plt.show()\n",\n    "df.to_csv(\"qtap_outputs/results.csv\",index=False)\n",\n    "with open(\"qtap_outputs/results.json\",\"w\") as f: json.dump({a:{\"qtap_kl\":res[a][\"kl\"]} for a in targets},f,indent=2)\n",\n    "print(\"saved qtap_outputs/\")"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "e6641f90",\n   "metadata": {},\n   "source": [\n    "## Publication upgrade\n",\n    "Set `targets=AA` for all 20 residues, increase `SHOTS` and `STEPS`, and replace synthetic references with Top8000-derived φ/ψ histograms using BioPython."\n   ]\n  }\n ],\n "metadata": {\n  "colab": {\n   "include_colab_link": true,\n   "provenance": []\n  },\n  "kernelspec": {\n   "display_name": "Python 3",\n   "name": "python3"\n  },\n  "language_info": {\n   "name": "python"\n  }\n },\n "nbformat": 4,\n "nbformat_minor": 5\n}\n