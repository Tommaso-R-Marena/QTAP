   "source": [
    "## 📊 Cell 10: Results Comparison + Bootstrap Confidence Intervals\n",
    "\n",
    "We compute bootstrap 95% CIs on KL divergence by resampling the PDB angle observations."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {"id": "results_ci"},
   "source": [
    "def bootstrap_kl_ci(\n",
    "    aa: str,\n",
    "    best_params: np.ndarray,\n",
    "    torsion_data: dict,\n",
    "    n_bootstrap: int = 200,\n",
    "    confidence: float = 0.95\n",
    ") -> tuple:\n",
    "    '''\n",
    "    Bootstrap 95% CI on KL divergence by resampling raw φ/ψ angle pairs.\n",
    "    \n",
    "    For each bootstrap replicate:\n",
    "        1. Resample N angles with replacement from torsion_data[aa]\n",
    "        2. Build empirical distribution from resample\n",
    "        3. Compute KL(resample_dist ‖ qtap_pred)\n",
    "    \n",
    "    Returns (ci_lower, ci_upper, kl_mean)\n",
    "    '''\n",
    "    pairs = np.array(torsion_data.get(aa, []))\n",
    "    if len(pairs) == 0:\n",
    "        return (np.nan, np.nan, np.nan)\n",
    "    \n",
    "    qtap_pred = born_distribution(encoding_angles[aa], np.array(best_params),\n",
    "                                  n_shots=N_SHOTS * 2)\n",
    "    \n",
    "    kl_samples = []\n",
    "    N = len(pairs)\n",
    "    for _ in range(n_bootstrap):\n",
    "        idx   = np.random.choice(N, N, replace=True)\n",
    "        resamp = pairs[idx]\n",
    "        counts = np.ones(N_BINS)   # Laplace smoothing\n",
    "        for phi, psi in resamp:\n",
    "            counts[angles_to_bin(phi, psi, GRID_SIZE)] += 1\n",
    "        dist_b = counts / counts.sum()\n",
    "        kl_samples.append(kl_divergence(dist_b, qtap_pred))\n",
    "    \n",
    "